NODE_ENV=development
PORT=3001
# Set to the exact public frontend origin when the API is behind a same-origin proxy.
APP_ORIGIN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=campusflow
MYSQL_PASSWORD=change-this-database-password
MYSQL_DATABASE=campusflow
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password
MYSQL_SSL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Used by the administrator bootstrap command; do not commit real values.
BOOTSTRAP_ADMIN_NAME=CampusFlow Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Set a unique random value of at least 32 characters for administrator account provisioning.
# Enter the same value in the account form's Temporary setup token field; remove it to disable provisioning.
USER_PROVISIONING_TOKEN=replace-with-a-separate-random-token-at-least-32-characters-long
